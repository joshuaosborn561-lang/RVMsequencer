DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rvm_drop"

# Shared rate limits + org daily counters (Railway Redis)
REDIS_URL=

# Public app URL (Twilio webhooks + provider callback_url)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Persistent file-store directory (Railway volume mount → /data)
DATA_DIR=".data"

# Protects POST /api/sequencer/tick (Railway cron sends x-cron-secret)
CRON_SECRET=

# Twilio — number inventory + inbound callback webhooks
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Callbacks: inbound voice on campaign DIDs dials this E.164 (overrides UI setting)
CALL_FORWARD_TO_E164=

# Default RVM provider: slybroadcast | mock
RVM_PROVIDER=slybroadcast

# Slybroadcast — default delivery (c_url + c_callerID = your Twilio DID)
# Docs: https://www.slybroadcast.com/documentationjson.php
SLYBROADCAST_UID=
SLYBROADCAST_PASSWORD=

# DNC scrub — The DNC Project (PAYG)
DNC_PROJECT_API_TOKEN=

# Provider status → attempt ledger (Bearer / x-webhook-secret / ?secret=)
RVM_STATUS_WEBHOOK_SECRET=

# HubSpot — sync callbacks when a client has hubspotOptIn
HUBSPOT_ACCESS_TOKEN=

# MCP (Claude) — see mcp/README.md
# RVM_DROP_BASE_URL=https://rvm-drop-production.up.railway.app
# RVM_DROP_CRON_SECRET=
# RVM_DROP_WEBHOOK_SECRET=

# Optional: require Bearer token for POST/GET /api/mcp (Claude Connectors)
# MCP_HTTP_TOKEN=
