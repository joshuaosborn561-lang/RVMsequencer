DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dropseq"

# Twilio — number inventory + optional AMD fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Preferred cheap RVM API (default): Slybroadcast
# Docs: https://www.slybroadcast.com/documentationjson.php
SLYBROADCAST_UID=
SLYBROADCAST_PASSWORD=

# Alt: Drop.co Customer API — https://apidocs.drop.co/
DROP_CO_API_KEY=
DROP_CO_CAMPAIGN_TOKEN=

# Alt: LeadsRain — https://leadsrain.com/apidocs/
LEADSRAIN_API_KEY=
LEADSRAIN_USERNAME=

# Optional premium / legacy
VOICEDROP_API_KEY=
DROP_COWBOY_TEAM_ID=
DROP_COWBOY_SECRET=

# TTS / voice clone (your audio → provider deposits it)
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RVM_STATUS_WEBHOOK_SECRET=
