DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rvm_drop"

# Shared rate limits + org daily counters (Railway Redis)
REDIS_URL=

# Public app URL (Twilio webhooks + Drop Cowboy callback_url)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Persistent file-store directory (Railway volume mount → /data)
DATA_DIR=".data"

# Protects POST /api/sequencer/tick (Railway cron sends x-cron-secret)
CRON_SECRET=

# Twilio — number inventory + inbound callback webhooks
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Callbacks: inbound voice on campaign DIDs dials this E.164 (overrides UI setting)
CALL_FORWARD_TO_E164=

# Drop Cowboy — default RVM delivery (https://api.dropcowboy.com/v1/rvm)
# Docs: https://drop-cowboy.gitbook.io/drop-cowboy-docs/
DROPCOWBOY_TEAM_ID=
DROPCOWBOY_SECRET=
DROPCOWBOY_BRAND_ID=
# Optional default recording GUID (override per campaign)
DROPCOWBOY_RECORDING_ID=
# Optional private number pool
DROPCOWBOY_POOL_ID=
# Set to 1 only if Drop Cowboy BYOC is enabled (sends caller_id = your Twilio DID)
DROPCOWBOY_BYOC_CALLER_ID=

# DNC scrub — The DNC Project (PAYG)
# Docs: https://thedncproject.org/api-documentation
DNC_PROJECT_API_TOKEN=

# Alt PAYG deposit (not default)
SLYBROADCAST_UID=
SLYBROADCAST_PASSWORD=

# Provider status → attempt ledger (Bearer / x-webhook-secret / ?secret=)
# Point Drop Cowboy callback_url at /api/webhooks/rvm-status?secret=…
RVM_STATUS_WEBHOOK_SECRET=

# HubSpot — sync callbacks when a client has hubspotOptIn (Client Access UI)
# Private app scopes: crm.objects.contacts.read/write, crm.objects.calls.write, crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=
