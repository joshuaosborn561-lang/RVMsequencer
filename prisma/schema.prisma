// Dropseq domain model — Smartlead-style sequencer for RVM
// Delivery is pluggable; Twilio owns number inventory.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LineStatus {
  PROVISIONING
  WARMING
  HEALTHY
  DEGRADED
  QUARANTINED
  RETIRED
}

enum DeliveryMode {
  RVM_PROVIDER
  TWILIO_AMD
}

enum DeliveryProvider {
  SLYBROADCAST
  DROP_CO
  LEADSRAIN
  VOICEDROP
  DROP_COWBOY
  TWILIO_AMD
  MOCK
}

enum VoiceProvider {
  CARTESIA
  ELEVENLABS
  UPLOAD
  STOCK
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum LeadConsentStatus {
  UNKNOWN
  EXPRESS_WRITTEN
  EXPRESS_ORAL
  ESTABLISHED_BUSINESS
  OPTED_OUT
}

enum AttemptStatus {
  QUEUED
  SKIPPED_CONSENT
  SKIPPED_DNC
  SKIPPED_TIMEZONE
  SKIPPED_CAP
  RENDERING
  SENDING
  DELIVERED
  FAILED
  HUMAN_ANSWERED
  OPTED_OUT
  CALLBACK
}

enum ReputationLabel {
  UNFLAGGED
  MIXED_LOW
  MIXED_HIGH
  FLAGGED
  UNKNOWN
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  /// Org-wide hard cap on RVM deposits per UTC day.
  hardCapDailySends Int @default(1000)
  lineMinGapSec     Int @default(600)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines         PhoneLine[]
  campaigns     Campaign[]
  voices        VoiceProfile[]
  leads         Lead[]
  providers     ProviderCredential[]
  clients       Client[]
  inbox         InboxMessage[]
  suppressions  Suppression[]
}

/// Book-of-business tenant under a workspace (agency → client).
model Client {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apiKeys  ClientApiKey[]
  inbox    InboxMessage[]
  campaigns Campaign[]

  @@index([workspaceId])
}

/// Per-client API key for programmatic campaign/lead access.
model ClientApiKey {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  name       String
  /// SHA-256 hex of the secret; plaintext shown once at creation.
  keyHash    String
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([clientId])
  @@index([keyPrefix])
}

enum InboxChannel {
  VOICE_CALLBACK
  SMS
  NOTE
}

enum InboxCategory {
  UNREAD
  INTERESTED
  NOT_INTERESTED
  CALLBACK
  DNC
  OTHER
}

/// Master Inbox / unibox — Twilio inbound voice/SMS + manual notes.
model InboxMessage {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id])
  campaignId  String?
  leadId      String?
  fromE164    String
  toE164      String
  channel     InboxChannel
  body        String
  category    InboxCategory @default(UNREAD)
  readAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([workspaceId, createdAt])
  @@index([clientId, category])
  @@index([fromE164])
}

model ProviderCredential {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  provider    DeliveryProvider
  // Encrypted JSON blob in production
  configJson  Json
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([workspaceId, provider])
}

model PhoneLine {
  id              String     @id @default(cuid())
  workspaceId     String
  workspace       Workspace  @relation(fields: [workspaceId], references: [id])
  twilioSid       String?
  e164            String
  friendlyName    String?
  areaCode        String?
  status          LineStatus @default(PROVISIONING)
  warmupDay       Int        @default(0)
  dailyCap        Int        @default(25)
  targetDailyCap  Int        @default(80)
  sentToday       Int        @default(0)
  sentTodayDate   DateTime?  @db.Date
  lifetimeSent    Int        @default(0)
  deliveryRate7d  Float?
  callbackRate7d  Float?
  reputationLabel ReputationLabel @default(UNKNOWN)
  lastReputationAt DateTime?
  lastSentAt      DateTime?
  /// Min seconds between deposits on this DID (mailbox spacing).
  minGapSec       Int        @default(600)
  registeredFcr   Boolean    @default(false)
  voiceIntegrity  Boolean    @default(false)
  stirShakenLevel String?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  campaignLines CampaignLine[]
  attempts      DeliveryAttempt[]
  healthEvents  LineHealthEvent[]

  @@unique([workspaceId, e164])
  @@index([workspaceId, status])
}

model LineHealthEvent {
  id        String   @id @default(cuid())
  lineId    String
  line      PhoneLine @relation(fields: [lineId], references: [id])
  kind      String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([lineId, createdAt])
}

model VoiceProfile {
  id           String        @id @default(cuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  name         String
  provider     VoiceProvider
  externalId   String?
  isClone      Boolean       @default(false)
  sampleUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  audioAssets AudioAsset[]
  steps       SequenceStep[]
}

model AudioAsset {
  id          String        @id @default(cuid())
  voiceId     String?
  voice       VoiceProfile? @relation(fields: [voiceId], references: [id])
  kind        String // static | intro_template | body
  scriptText  String?
  storageUrl  String
  durationMs  Int?
  charCount   Int?
  createdAt   DateTime      @default(now())

  steps SequenceStep[]
}

model Campaign {
  id              String         @id @default(cuid())
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id])
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id])
  name            String
  status          CampaignStatus @default(DRAFT)
  deliveryMode    DeliveryMode   @default(RVM_PROVIDER)
  deliveryProvider DeliveryProvider @default(MOCK)
  timezone        String         @default("America/New_York")
  sendWindowStart Int            @default(9) // local hour
  sendWindowEnd   Int            @default(20)
  sendDays        Int[]          @default([1, 2, 3, 4, 5]) // Mon-Fri
  stopOnCallback  Boolean        @default(true)
  stopOnOptOut    Boolean        @default(true)
  // Soft by default (cold-call / grey-area operator posture). DNC still hard-gated in code.
  requireConsent  Boolean        @default(false)
  jitterSeconds   Int            @default(45)
  /// Warmbly-style ramp — can only LOWER volume vs line pool.
  rampEnabled     Boolean        @default(false)
  rampStartPerDay Int            @default(25)
  rampIncrementPerDay Int        @default(25)
  rampCeilingPerDay Int          @default(200)
  rampActivatedAt DateTime?
  /// Advisory lease for concurrent drain workers.
  leaseOwner      String?
  leaseUntil      DateTime?
  lastError       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines     CampaignLine[]
  steps     SequenceStep[]
  enrollments CampaignEnrollment[]
  attempts  DeliveryAttempt[]

  @@index([clientId])
  @@index([status, leaseUntil])
}

model CampaignLine {
  campaignId String
  lineId     String
  campaign   Campaign  @relation(fields: [campaignId], references: [id])
  line       PhoneLine @relation(fields: [lineId], references: [id])
  priority   Int       @default(0)

  @@id([campaignId, lineId])
}

model SequenceStep {
  id            String      @id @default(cuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id])
  position      Int
  delayDays     Int         @default(0)
  scriptTemplate String
  voiceId       String?
  voice         VoiceProfile? @relation(fields: [voiceId], references: [id])
  audioAssetId  String?
  audioAsset    AudioAsset? @relation(fields: [audioAssetId], references: [id])
  personalize   Boolean     @default(true)

  enrollments CampaignEnrollment[]
  attempts    DeliveryAttempt[]

  @@unique([campaignId, position])
}

model Lead {
  id            String             @id @default(cuid())
  workspaceId   String
  workspace     Workspace          @relation(fields: [workspaceId], references: [id])
  phoneE164     String
  firstName     String?
  lastName      String?
  company       String?
  email         String?
  timezone      String?
  consentStatus LeadConsentStatus  @default(UNKNOWN)
  consentSource String?
  consentAt     DateTime?
  dnc           Boolean            @default(false)
  customJson    Json?
  stickyLineId  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  enrollments CampaignEnrollment[]
  attempts    DeliveryAttempt[]

  @@unique([workspaceId, phoneE164])
  @@index([workspaceId, dnc])
}

/// Workspace-wide suppression (DNC / STOP / callback / scrub).
model Suppression {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  phoneE164   String
  reason      String
  source      String
  createdAt   DateTime @default(now())

  @@unique([workspaceId, phoneE164])
  @@index([phoneE164])
}

model CampaignEnrollment {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id])
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id])
  currentStepId String?
  currentStep  SequenceStep? @relation(fields: [currentStepId], references: [id])
  nextRunAt    DateTime?
  completedAt  DateTime?
  pausedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([campaignId, leadId])
  @@index([nextRunAt])
}

model DeliveryAttempt {
  id              String         @id @default(cuid())
  campaignId      String
  campaign        Campaign       @relation(fields: [campaignId], references: [id])
  leadId          String
  lead            Lead           @relation(fields: [leadId], references: [id])
  stepId          String?
  step            SequenceStep?  @relation(fields: [stepId], references: [id])
  lineId          String?
  line            PhoneLine?     @relation(fields: [lineId], references: [id])
  status          AttemptStatus  @default(QUEUED)
  provider        DeliveryProvider
  providerMsgId   String?
  audioUrl        String?
  costEstimateUsd Float?
  errorCode       String?
  errorDetail     String?
  /// Natural key for idempotent send (campaign_lead_step).
  idempotencyKey  String?
  scheduledAt     DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([idempotencyKey])
  @@index([campaignId, status])
  @@index([lineId, sentAt])
  @@index([providerMsgId])
  @@index([leadId, status])
}

/// Durable send queue — claimed with FOR UPDATE SKIP LOCKED.
/// IDs reference the file-store (or Prisma) campaign/lead without FK coupling.
enum ScheduledSendStatus {
  PENDING
  CLAIMED
  SENT
  SKIPPED
  FAILED
  CANCELLED
  SUPPRESSED
}

model ScheduledSend {
  id             String              @id @default(cuid())
  campaignId     String
  leadId         String
  stepPosition   Int
  phoneE164      String
  stickyLineId   String?
  status         ScheduledSendStatus @default(PENDING)
  runAt          DateTime
  claimedAt      DateTime?
  claimOwner     String?
  idempotencyKey String              @unique
  providerMsgId  String?
  lastError      String?
  attemptCount   Int                 @default(0)
  deliveryStatus String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, runAt])
  @@index([campaignId, status, runAt])
  @@index([providerMsgId])
  @@index([leadId, stepPosition])
}

/// Org daily send counter when Redis is unavailable.
model OrgDailyCounter {
  dateKey String @id
  sends   Int    @default(0)
  updatedAt DateTime @updatedAt
}
